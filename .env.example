# On Forge: Site → Environment. Paste these lines there (Forge saves them to .env in the site folder).
# For local development, copy this file to .env.

# Required: the passcode for the team lead dashboard. Use a long, random value.
ADMIN_PASSCODE=change-me-to-something-long

# Optional, recommended: members must open a link with ?team=CODE (or type the code) before results are sent.
TEAM_CODE=

# Optional: where results are saved. Leave it unset on Forge.
# Default: <site>/storage. With zero-downtime deployments that is the site folder's storage
# (for example /home/forge/rapport.example.com/storage), not the release folder, so data survives deploys.
# DATA_DIR=/home/forge/rapport-data

# Optional
# MAX_MEMBERS=200
